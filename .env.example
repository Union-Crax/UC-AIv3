DISCORD_TOKEN=your_discord_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
MODEL_NAME=anthropic/claude-3-opus
MAX_RESPONSE_TOKENS=256
MAX_RESPONSE_CHARS=260
MAX_RESPONSE_SENTENCES=3
MODEL_TEMPERATURE=0.5
SYSTEM_PROMPT=You are UC-AIv3, a friendly and helpful Discord chatbot.

# Autonomy behavior:
# - direct-only: only direct mentions or replies to the bot
# - balanced: direct + some autonomous participation
# - social: more autonomous participation
AUTONOMY_MODE=balanced

# Restrict autonomous (non-direct) participation to these channels.
# Comma-separated Discord channel IDs. Empty = all channels.
AUTONOMY_ALLOWED_CHANNEL_IDS=

# Probabilities used for autonomous behavior (0.0 to 1.0)
CONTINUE_REPLY_CHANCE=0.4
KEYWORD_REPLY_CHANCE=0.6
RANDOM_INTERJECTION_CHANCE=0.02

# Weighted proactive jump-in controls
PROACTIVE_SCORE_THRESHOLD=0.65
SIGNAL_QUESTION_BONUS=0.25
SIGNAL_ENGAGEMENT_BONUS=0.20
SIGNAL_KEYWORD_BONUS=0.30
SIGNAL_RECENT_BOT_BONUS=0.20
PROACTIVE_COOLDOWN_SECONDS=45

# Context isolation:
# - channel: shared channel memory
# - channel_user: per-user memory in channel (plus bot replies)
# - smart: direct mentions/replies use channel_user, autonomous jump-ins use channel
CONTEXT_ISOLATION_MODE=smart

# Friendly-fire: allow two UC-AIv3 instances to talk to each other.
# Set FRIENDLY_BOT_IDS to the Discord user ID of the other bot instance (comma-separated).
# BOT_CONVO_MAX_TURNS caps how many back-and-forth exchanges happen before this bot disengages,
# preventing infinite reply loops. A human speaking in the channel resets the counter.
FRIENDLY_BOT_IDS=
BOT_CONVO_MAX_TURNS=6
